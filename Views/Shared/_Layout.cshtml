<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Community Connect</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommunityResourceAssistant.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    Community Connect
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Resource">Resource Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Ai">Community Intake</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Resource/Create">Add Partner</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="brand-banner">
            <h2>Community Connect</h2>
            <p>Helping organizations connect people with trusted local support.</p>
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="app-footer">

        <div class="container">

            <h4>Community Connect</h4>

            <p>
                Helping organizations connect people with trusted local support.
            </p>

            <div class="footer-nav">

                <a href="/Resource">Resource Dashboard</a>

                <span>•</span>

                <a href="/Ai">Community Intake</a>

                <span>•</span>

                <a href="/Resource/Create">Add Community Partner</a>

            </div>

            <hr />

            <small>
                © 2026 Community Connect
            </small>

            <br />

            <small>
                Built with ASP.NET Core MVC • C# • Bootstrap
            </small>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>