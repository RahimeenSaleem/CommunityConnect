@{
}
@model CommunityResourceAssistant.Models.Resource

<div class="page-header">
    <h1>Edit Community Partner</h1>
    <p>Update this organization’s referral information.</p>
</div>

<div class="form-box">
    <form method="post">

        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Partner Name</label>
            <input class="form-control-custom" name="Name" value="@Model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-control-custom" name="Category">
                <option value="Food">Food</option>
                <option value="Housing">Housing</option>
                <option value="Employment">Employment</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Legal Aid">Legal Aid</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <input class="form-control-custom" name="Description" value="@Model.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contact Information</label>
            <input class="form-control-custom" name="ContactInfo" value="@Model.ContactInfo" />
        </div>

        <div class="mb-3">
            <label class="form-label">City</label>
            <input class="form-control-custom" name="City" value="@Model.City" />
        </div>

        <div class="mb-3">
            <label class="form-label">Hours</label>
            <input class="form-control-custom" name="Hours" value="@Model.Hours" />
        </div>

        <div class="mb-3">
            <label class="form-label">Website</label>
            <input class="form-control-custom" name="Website" value="@Model.Website" />
        </div>

        <div class="mb-3">
            <label class="form-label">Languages</label>
            <input class="form-control-custom" name="Languages" value="@Model.Languages" />
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select class="form-control-custom" name="Status">
                <option value="Open Today">Open Today</option>
                <option value="Open 24 Hours">Open 24 Hours</option>
                <option value="Currently Closed">Currently Closed</option>
                <option value="Limited Availability">Limited Availability</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Availability</label>
            <select class="form-control-custom" name="Availability">
                <option value="Walk-ins Welcome">Walk-ins Welcome</option>
                <option value="Appointment Required">Appointment Required</option>
                <option value="Emergency Services Available">Emergency Services Available</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Last Updated</label>
            <input class="form-control-custom" name="LastUpdated" value="@Model.LastUpdated" />
        </div>

        <div class="mb-3">
            <input type="checkbox" name="IsVerified" value="true" checked="@Model.IsVerified" />
            <label>Verified Community Partner</label>
        </div>

        <button class="btn-main" type="submit">Save Changes</button>

        <a class="btn-secondary-custom" href="/Resource">
            Cancel
        </a>

    </form>
</div>