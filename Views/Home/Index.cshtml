@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <p class="eyebrow">Community referral platform</p>

    <h1>Connect people to the right support faster.</h1>

    <p>
        Community Connect helps nonprofits, community centers, and service organizations
        organize trusted local resources and generate explainable referral recommendations.
    </p>

    <div class="hero-buttons">
        <a class="btn-main" href="/Ai">Start Community Intake</a>
        <a class="btn-secondary-custom" href="/Resource">View Resource Dashboard</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-3">
        <div class="stat-card">
            <h4>@ViewBag.TotalResources</h4>
            <p>Trusted Partners</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <h4>@ViewBag.CitiesCovered</h4>
            <p>Cities Served</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <h4>@ViewBag.SupportAreas</h4>
            <p>Support Areas</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <h4>@ViewBag.VerifiedPercentage%</h4>
            <p>Verified Data</p>
        </div>
    </div>
</div>
<div class="info-section mt-5">
    <h2>The Challenge</h2>

    <p>
        Community organizations often help people facing food insecurity, housing instability,
        job loss, healthcare barriers, and legal concerns. But referral information is often
        scattered across websites, spreadsheets, printed lists, and staff memory.
    </p>

    <p>
        This can make it difficult for staff and volunteers to quickly identify the right support
        service, especially when someone has more than one need.
    </p>
</div>

<div id="features" class="info-section mt-4">
    <h2>Our Solution</h2>

    <p>
        Community Connect brings trusted local resources into one organized platform.
        Staff can complete a guided intake, review recommended support areas, and connect
        people with verified community partners.
    </p>

    <p>
        Every recommendation includes a reason, helping volunteers understand why a support
        area was suggested and keeping humans in control of the final referral decision.
    </p>
</div>

<div class="section-title mt-5">
    <h2>Key Features</h2>
    <p>Designed to support real community referral workflows.</p>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Resource Directory</h4>
            <p>Manage verified food, housing, employment, healthcare, and legal aid partners.</p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Community Intake</h4>
            <p>Capture who needs help, what happened, urgency, and additional notes.</p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Explainable Referrals</h4>
            <p>Show why each support area was recommended based on intake details.</p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Verified Partners</h4>
            <p>Highlight trusted organizations with status, hours, languages, and availability.</p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Resource Profiles</h4>
            <p>View complete partner details including contact, website, city, and last update.</p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="feature-card">
            <h4>Dashboard View</h4>
            <p>Track total resources, verified partners, cities covered, and support areas.</p>
        </div>
    </div>
</div>

<div class="info-section mt-5">
    <h2>How It Works</h2>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="step-card">
                <strong>1</strong>
                <p>Complete a community intake.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="step-card">
                <strong>2</strong>
                <p>Identify relevant support areas.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="step-card">
                <strong>3</strong>
                <p>Review trusted partner recommendations.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="step-card">
                <strong>4</strong>
                <p>Connect people with support.</p>
            </div>
        </div>
    </div>
</div>

<div id="about" class="info-section mt-5">
    <h2>Who Is It For?</h2>

    <p>
        Community Connect is designed for organizations and teams that help people navigate
        local support services.
    </p>

    <div class="audience-list">
        <span>Community Centers</span>
        <span>Nonprofits</span>
        <span>Libraries</span>
        <span>School Counselors</span>
        <span>Faith-based Organizations</span>
        <span>Municipal Service Offices</span>
    </div>
</div>

<div class="cta-section mt-5">
    <h2>Ready to connect people with support?</h2>

    <p>
        Start an intake or explore the verified community resource dashboard.
    </p>

    <a class="btn-main" href="/Ai">Start Community Intake</a>
    <a class="btn-secondary-custom" href="/Resource">Browse Partners</a>
</div>